<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- FanControl V2xx+ ships a .NET 10 build; plugins load into its process. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>FanControl.UsbTemp</AssemblyName>
    <RootNamespace>FanControl.UsbTemp</RootNamespace>
    <Nullable>disable</Nullable>
    <Version>2.0.0</Version>
    <Copyright>Copyright © 2023</Copyright>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Build against the installed FanControl: dotnet build -c Release -p:FanControlDir="C:\Program Files (x86)\FanControl" -->
    <FanControlDir Condition="'$(FanControlDir)' == ''">C:\Program Files (x86)\FanControl</FanControlDir>
  </PropertyGroup>

  <!-- Everything below is supplied by FanControl at runtime, so it is referenced but never copied. -->
  <ItemGroup>
    <Reference Include="FanControl.Plugins">
      <HintPath>$(FanControlDir)\FanControl.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(FanControlDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Ports">
      <HintPath>$(FanControlDir)\System.IO.Ports.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
